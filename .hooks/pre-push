#!/usr/bin/env bash
# Pre-push hook: light hygiene only — no rustup, no fmt/clippy, no tests.
#
# Catches "dead source still mirrored" / missing embedded-asset sources
# (e.g. deleted `.claude/skills/...` still listed in MIRRORED_FILES).
# Full test / CI parity is manual: `./scripts/run-tests.sh` or
# `./scripts/ci-rust-gate.sh` when you choose to run them.
#
# Skip with: git push --no-verify

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

# Hooks inherit Git env vars (GIT_DIR/GIT_INDEX_FILE/etc.).
# Unset them so nested `git` calls do not see the outer repo.
while IFS= read -r git_env_var; do
  unset "$git_env_var"
done < <(git rev-parse --local-env-vars)

echo "🔍 Pre-push: embedded / dead-source sync check only..."
./scripts/sync-embedded-files.sh check
echo "✅ Pre-push hygiene passed (tests not run — run manually if needed)"
