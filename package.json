{
  "name": "ralph-orchestrator",
  "version": "2.9.2",
  "private": true,
  "description": "AI agent orchestrator with web dashboard",
  "workspaces": [
    "backend/*",
    "frontend/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:web": "npm run build -w @ralph-web/dashboard",
    "build:monitor": "npm run build -w @ralph-monitor/server",
    "dev": "npm run dev:web",
    "dev:api": "cargo run -p ralph-api",
    "dev:web": "npm run dev -w @ralph-web/dashboard",
    "dev:monitor": "npm run dev -w @ralph-monitor/server",
    "start": "cargo run -p ralph-api",
    "start:monitor": "npm run start -w @ralph-monitor/server",
    "test": "npm run test --workspaces --if-present",
    "test:monitor": "npm test -w @ralph-monitor/server",
    "build:devtools": "npm run build -w @ralph-devtools/cli",
    "test:devtools": "npm test -w @ralph-devtools/cli",
    "clean": "npm run clean --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "ai",
    "agent",
    "orchestrator",
    "ralph"
  ],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "better-sqlite3@12.6.2": true
  }
}
